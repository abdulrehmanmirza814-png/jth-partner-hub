# Copy this file to ".env" and fill it in. NEVER share or commit ".env".
ANTHROPIC_API_KEY=paste-your-key-here

# Optional: your name exactly as it appears in your exported WhatsApp chats
# OWNER_NAME=Abdul Rehman

# Optional: get a phone notification when something needs you (install the free "ntfy" app, pick a hard-to-guess topic)
# NTFY_TOPIC=jth-abdul-8f3k2x

# Optional: use a cheaper/faster model, e.g. claude-sonnet-5-5 or claude-haiku-5-5
# AGENT_MODEL=claude-opus-5-5

# Optional: path to Chrome if it isn't found automatically
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
